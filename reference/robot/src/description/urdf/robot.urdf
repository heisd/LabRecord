<?xml version="1.0"?>
<robot name="li_arm">
  <material name="black"><color rgba="0.05 0.05 0.05 1"/></material>
  <material name="grey"><color rgba="0.7 0.7 0.7 1"/></material>

  <link name="base_link">
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><cylinder length="0.06" radius="0.10"/></geometry><material name="black"/></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><cylinder length="0.06" radius="0.10"/></geometry></collision>
    <inertial><origin xyz="0 0 0" rpy="0 0 0"/><mass value="2.0"/><inertia ixx="0.01" iyy="0.01" izz="0.02" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <link name="base_turntable">
    <visual><origin xyz="0 0 0.03" rpy="0 0 0"/><geometry><cylinder length="0.02" radius="0.10"/></geometry><material name="black"/></visual>
    <collision><origin xyz="0 0 0.03" rpy="0 0 0"/><geometry><cylinder length="0.02" radius="0.10"/></geometry></collision>
    <inertial><origin xyz="0 0 0.03" rpy="0 0 0"/><mass value="1.0"/><inertia ixx="0.005" iyy="0.005" izz="0.01" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <joint name="base_yaw" type="revolute">
    <parent link="base_link"/><child link="base_turntable"/>
    <origin xyz="0 0 0.03" rpy="0 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="10" velocity="2.0"/>
  </joint>

  <link name="shoulder_link">
    <visual><origin xyz="0 0 0.05" rpy="0 0 0"/><geometry><box size="0.08 0.06 0.10"/></geometry><material name="grey"/></visual>
    <collision><origin xyz="0 0 0.05" rpy="0 0 0"/><geometry><box size="0.08 0.06 0.10"/></geometry></collision>
    <inertial><origin xyz="0 0 0.05" rpy="0 0 0"/><mass value="0.8"/><inertia ixx="0.003" iyy="0.003" izz="0.003" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <joint name="shoulder_pitch" type="revolute">
    <parent link="base_turntable"/><child link="shoulder_link"/>
    <origin xyz="0 0 0.02" rpy="0 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="1.5"/>
  </joint>

  <link name="upper_arm_link">
    <visual><origin xyz="0.06 0 0.05" rpy="0 0 0"/><geometry><box size="0.12 0.04 0.04"/></geometry><material name="black"/></visual>
    <collision><origin xyz="0.06 0 0.05" rpy="0 0 0"/><geometry><box size="0.12 0.04 0.04"/></geometry></collision>
    <inertial><origin xyz="0.06 0 0.05" rpy="0 0 0"/><mass value="0.6"/><inertia ixx="0.002" iyy="0.002" izz="0.002" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <joint name="elbow_pitch" type="revolute">
    <parent link="shoulder_link"/><child link="upper_arm_link"/>
    <origin xyz="0 0 0.10" rpy="0 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="1.5"/>
  </joint>

  <link name="forearm_link">
    <visual><origin xyz="0.06 0 0" rpy="0 0 0"/><geometry><box size="0.12 0.035 0.035"/></geometry><material name="black"/></visual>
    <collision><origin xyz="0.06 0 0" rpy="0 0 0"/><geometry><box size="0.12 0.035 0.035"/></geometry></collision>
    <inertial><origin xyz="0.06 0 0" rpy="0 0 0"/><mass value="0.5"/><inertia ixx="0.0018" iyy="0.0018" izz="0.0018" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <joint name="wrist_pitch" type="revolute">
    <parent link="upper_arm_link"/><child link="forearm_link"/>
    <origin xyz="0.12 0 0.05" rpy="0 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="8" velocity="2.0"/>
  </joint>

  <link name="wrist_link">
    <visual><origin xyz="0.03 0 0" rpy="0 0 0"/><geometry><box size="0.06 0.03 0.03"/></geometry><material name="grey"/></visual>
    <collision><origin xyz="0.03 0 0" rpy="0 0 0"/><geometry><box size="0.06 0.03 0.03"/></geometry></collision>
    <inertial><origin xyz="0.03 0 0" rpy="0 0 0"/><mass value="0.3"/><inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <joint name="wrist_roll" type="revolute">
    <parent link="forearm_link"/><child link="wrist_link"/>
    <origin xyz="0.12 0 0" rpy="0 0 0"/><axis xyz="1 0 0"/>
    <limit lower="-3.14159" upper="3.14159" effort="5" velocity="3.0"/>
  </joint>

  <link name="gripper_base">
    <visual><origin xyz="0.03 0 0" rpy="0 0 0"/><geometry><box size="0.06 0.03 0.02"/></geometry><material name="black"/></visual>
    <collision><origin xyz="0.03 0 0" rpy="0 0 0"/><geometry><box size="0.06 0.03 0.02"/></geometry></collision>
    <inertial><origin xyz="0.03 0 0" rpy="0 0 0"/><mass value="0.2"/><inertia ixx="0.0005" iyy="0.0005" izz="0.0005" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <joint name="gripper_mount" type="fixed">
    <parent link="wrist_link"/><child link="gripper_base"/>
    <origin xyz="0.06 0 0" rpy="0 0 0"/>
  </joint>

  <link name="finger_left">
    <visual><origin xyz="0.03 0.02 0" rpy="0 0 0"/><geometry><box size="0.06 0.01 0.02"/></geometry><material name="grey"/></visual>
    <collision><origin xyz="0.03 0.02 0" rpy="0 0 0"/><geometry><box size="0.06 0.01 0.02"/></geometry></collision>
    <inertial><origin xyz="0.03 0.02 0" rpy="0 0 0"/><mass value="0.05"/><inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <joint name="finger_left_joint" type="revolute">
    <parent link="gripper_base"/><child link="finger_left"/>
    <origin xyz="0 0.015 0" rpy="0 0 0"/><axis xyz="0 0 1"/>
    <limit lower="0.0" upper="0.5" effort="2" velocity="2.0"/>
  </joint>

  <link name="finger_right">
    <visual><origin xyz="0.03 -0.02 0" rpy="0 0 0"/><geometry><box size="0.06 0.01 0.02"/></geometry><material name="grey"/></visual>
    <collision><origin xyz="0.03 -0.02 0" rpy="0 0 0"/><geometry><box size="0.06 0.01 0.02"/></geometry></collision>
    <inertial><origin xyz="0.03 -0.02 0" rpy="0 0 0"/><mass value="0.05"/><inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <joint name="finger_right_joint" type="revolute">
    <parent link="gripper_base"/><child link="finger_right"/>
    <origin xyz="0 -0.015 0" rpy="0 0 0"/><axis xyz="0 0 1"/>
    <mimic joint="finger_left_joint" multiplier="-1.0" offset="0.0"/>
    <limit lower="-0.5" upper="0.0" effort="2" velocity="2.0"/>
  </joint>
</robot>