<?xml version="1.0"?>
<robot name="li_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">
<!--底盘部分-->
<base_link>
  <link name="base_link">
    <visual>
      <geometry>
        <cylinder length="0.1" radius="0.5"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.1" radius="0.5"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.3" iyy="0.3" izz="0.06" ixy="0.0" ixz="0.0" iyz="0.0"/>
    </inertial>
  </link>
</base_link>







</robot>